{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Project Repository Tests",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest",
            "args": [
                "--runInBand",
                "project.repository.spec.ts",
                "--testPathPattern=project.repository.spec.ts"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "sourceMaps": true
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Project E2E Tests",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest",
            "args": [
                "--runInBand",
                "--config",
                "./test/e2e/jest-e2e.json",
                "project.e2e-spec.ts"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "sourceMaps": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Auth E2E Tests",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest",
            "args": ["auth.e2e-spec.ts"],
            "cwd": "${workspaceFolder}"
        }
    ]
}