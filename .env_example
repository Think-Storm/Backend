# --- Database (Supabase) -----------------------------------------------------
# DATABASE_URL goes through the Supavisor pooler (transaction mode, port 6543).
# DIRECT_URL is the session-mode connection on 5432 and is used by Prisma CLI
# for `migrate deploy`. Locally both can point at the same Postgres.
DATABASE_URL=postgresql://[USER]:[PASSWORD]@[localhost|THINKSTORM_POSTGRES_DB_IMAGE_NAME]:[PORT]/[DB_NAME]
DIRECT_URL=postgresql://[USER]:[PASSWORD]@[localhost|THINKSTORM_POSTGRES_DB_IMAGE_NAME]:[PORT]/[DB_NAME]
DATABASE_UNIT_TEST_URL=postgresql://[USER]:[PASSWORD]@[localhost|THINKSTORM_POSTGRES_DB_IMAGE_NAME]:[PORT]/[UNIT_TEST_DB_NAME]
DATABASE_E2E_TEST_URL=postgresql://[USER]:[PASSWORD]@[localhost|THINKSTORM_POSTGRES_DB_IMAGE_NAME]:[PORT]/[E2E_TEST_DB_NAME]
DATABASE_COVERAGE_TEST_URL=postgresql://[USER]:[PASSWORD]@[localhost|THINKSTORM_POSTGRES_DB_IMAGE_NAME]:[PORT]/[COVERAGE_DB_NAME]

# --- Auth --------------------------------------------------------------------
JWT_SECRET=THINKSTORM_JWT_SECRET
JWT_EXPIRES_IN=THINKSTORM_JWT_EXPIRES_IN
JWT_COOKIE_EXPIRES_IN=THINKSTORM_COOKIE_EXPIRES_IN

# --- Redis (Upstash) ---------------------------------------------------------
# REDIS_USER / REDIS_PASSWORD are consumed by the local docker-compose Redis.
# Hosted Redis is addressed entirely through the two URLs (use rediss:// for TLS).
REDIS_USER=REDIS_USER
REDIS_PASSWORD=REDIS_PASSWORD
REDIS_CACHING_TTL=CACHING_REDIS_TTL
REDIS_THROTTLER_URL=redis://[REDIS_USER]:[REDIS_PASSWORD]@[localhost|THINKSTORM_REDIS_DB_IMAGE_NAME]:[REDIS_PORT]/[THROTTLER_REDIS_DB_NUM]
REDIS_CACHING_URL=redis://[REDIS_USER]:[REDIS_PASSWORD]@[localhost|THINKSTORM_REDIS_DB_IMAGE_NAME]:[REDIS_PORT]/[CACHING_REDIS_DB_NUM]

# --- Runtime -----------------------------------------------------------------
NODE_ENV=[development|production]
# Injected by the host (Render); defaults to 3001 when unset.
PORT=3001
FRONTEND_URL=FRONT_URL
# Set to false to skip building the OpenAPI document at boot on a cold-start
# sensitive host. Any other value (or unset) serves /api-docs as before.
SWAGGER_ENABLED=true

# --- Email (Resend) ----------------------------------------------------------
# MAIL_FROM must be on a domain verified in Resend; the free tier allows one.
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
MAIL_FROM=info@thinkstorm.app

# --- Storage (Supabase Storage) ----------------------------------------------
# Service-role key is server-side only — it bypasses row level security.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_STORAGE_BUCKET=YOUR_BUCKET_NAME

# --- Packages ----------------------------------------------------------------
CONTRACT_ACCESS_TOKEN=YOUR_OWN_ACCESS_TOKEN
