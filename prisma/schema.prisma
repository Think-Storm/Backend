datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int           @id @default(autoincrement())
  email             String        @unique
  username          String
  password          String
  passwordSalt      String        @map("password_salt")
  passwordChangedAt DateTime?
  fullName          String?       @map("full_name")
  birthdate         DateTime?
  founded_projects  Project[]     @relation("FounderProjects")
  projects          Project[]
  like              Like[]
  involvement       Involvement[]
  joinRequest       JoinRequest[]
  userProfile       UserProfile?
  createdAt         DateTime      @default(now()) @map("created_at")
  lastUpdatedAt     DateTime      @updatedAt @map("last_updated_at")

  @@map("users")
}

model UserProfile {
  id           Int                         @id @default(autoincrement())
  userId       Int                         @unique @map("user_id")
  avatar       String?
  bio          String?
  preferedRole String?                     @map("prefered_role")
  location     String?
  website      String?
  interests    UserProfileDomainLabel[]
  skills       UserProfileTechnicalLabel[]
  user         User                        @relation(fields: [userId], references: [id], onUpdate: Cascade)
  languages    UserProfileLanguage[]
  role         Role?                       @relation(fields: [preferedRole], references: [name], onUpdate: Cascade)

  @@map("user_profiles")
}

model Project {
  id              Int                     @id @default(autoincrement())
  founderId       Int                     @map("founder_id")
  title           String
  description     String?
  goal            Goal
  status          ProjectStatus
  languageCode    LanguageCode            @map("language_code")
  milestone       DateTime?
  createdAt       DateTime                @default(now()) @map("created_at")
  lastUpdatedAt   DateTime                @updatedAt @map("last_updated_at")
  founder         User?                   @relation(fields: [founderId], references: [id], name: "FounderProjects", onDelete: SetNull)
  language        Language?               @relation(fields: [languageCode], references: [code], onDelete: SetNull)
  users           User[]
  domainLabels    ProjectDomainLabel[]
  technicalLabels ProjectTechnicalLabel[]
  like            Like[]
  involvement     Involvement[]
  joinRequest     JoinRequest[]

  @@map("projects")
}

model TechnicalLabel {
  name     String                      @id @unique
  projects ProjectTechnicalLabel[]
  users    UserProfileTechnicalLabel[]

  @@map("technical_labels")
}

model DomainLabel {
  name     String                   @id @unique
  projects ProjectDomainLabel[]
  users    UserProfileDomainLabel[]

  @@map("domain_labels")
}

model UserProfileDomainLabel {
  userId      Int          @map("user_id")
  labelName   String       @map("label_name")
  label       DomainLabel  @relation(fields: [labelName], references: [name], onUpdate: Cascade)
  userProfile UserProfile? @relation(fields: [userId], references: [userId], onUpdate: Cascade)

  @@id([userId, labelName])
  @@map("user_profile_domain_labels")
}

model UserProfileTechnicalLabel {
  userId      Int            @map("user_id")
  labelName   String         @map("label_name")
  label       TechnicalLabel @relation(fields: [labelName], references: [name], onUpdate: Cascade)
  userProfile UserProfile?   @relation(fields: [userId], references: [userId], onUpdate: Cascade)

  @@id([userId, labelName])
  @@map("user_profile_technical_labels")
}

model ProjectDomainLabel {
  projectId Int         @map("project_id")
  labelName String      @map("label_name")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     DomainLabel @relation(fields: [labelName], references: [name], onDelete: Cascade)

  @@id([projectId, labelName])
  @@map("project_domain_labels")
}

model ProjectTechnicalLabel {
  projectId Int            @map("project_id")
  labelName String         @map("label_name")
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     TechnicalLabel @relation(fields: [labelName], references: [name], onDelete: Cascade)

  @@id([projectId, labelName])
  @@map("project_technical_labels")
}

model Like {
  userId    Int     @map("user_id")
  projectId Int     @map("project_id")
  user      User    @relation(fields: [userId], references: [id])
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("likes")
}

model Involvement {
  userId    Int     @map("user_id")
  projectId Int     @map("project_id")
  roleName  String  @map("role_name")
  user      User    @relation(fields: [userId], references: [id])
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleName], references: [name])

  @@id([userId, projectId])
  @@map("involvements")
}

model JoinRequest {
  userId    Int               @map("user_id")
  projectId Int               @map("project_id")
  roleName  String            @map("role_name")
  status    JoinRequestStatus @default(Pending)
  user      User              @relation(fields: [userId], references: [id])
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      Role              @relation(fields: [roleName], references: [name])

  @@id([userId, projectId])
  @@map("join_requests")
}

model Language {
  code          LanguageCode          @id
  name          LanguageName
  createdAt     DateTime              @default(now()) @map("created_at")
  lastUpdatedAt DateTime              @updatedAt @map("last_updated_at")
  projects      Project[]
  userProfiles  UserProfileLanguage[]

  @@map("languages")
}

model Role {
  name          String        @id @unique
  createdAt     DateTime      @default(now()) @map("created_at")
  lastUpdatedAt DateTime      @updatedAt @map("last_updated_at")
  joinRequests  JoinRequest[]
  Involvement   Involvement[]
  UserProfile   UserProfile[]

  @@map("roles")
}

model UserProfileLanguage {
  userId       Int          @map("user_id")
  languageCode LanguageCode @map("language_code")
  language     Language     @relation(fields: [languageCode], references: [code], onUpdate: Cascade)
  userProfile  UserProfile? @relation(fields: [userId], references: [userId], onUpdate: Cascade)

  @@id([userId, languageCode])
  @@map("user_profile_languages")
}

enum ProjectStatus {
  Complete
  InProgress
  OnHold
  Canceled
}

enum JoinRequestStatus {
  Pending
  Accepted
  Rejected
}

enum Goal {
  Education
  Profitable
  Fun
  OpenSource
}

enum LanguageCode {
  EN
  FR
  KR
  ES
  DE
  IT
  JA
  ZH
  RU
  AR
}

enum LanguageName {
  English
  French
  Korean
  Spanish
  German
  Italian
  Japanese
  Chinese
  Russian
  Arabic
}
